QWidget {
    background-color: #1e1f2b;
    color: #e8e8f0;
    font-size: 14px;
}

QPushButton {
    background-color: #3a3d56;
    border: 1px solid #55597a;
    border-radius: 8px;
    padding: 6px;
}

QPushButton:hover {
    background-color: #4a4e70;
}

QPushButton:checked {
    background-color: #c0392b;
}

QDoubleSpinBox {
    background-color: #2b2d3f;
    border: 1px solid #44475f;
    border-radius: 6px;
    padding: 2px 6px;
}

QDoubleSpinBox:read-only {
    background-color: #171822;
    color: #ffb347;
    font-weight: bold;
}

QSlider::groove:vertical {
    width: 8px;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff3b30, stop:1 #2d6cff);
}

QSlider::handle:vertical {
    height: 18px;
    margin: 0 -6px;
    background: #f5f5f5;
    border: 2px solid #ffb347;
    border-radius: 9px;
}

QFrame#bridge {
    background-color: #8a8fa8;
    border: 1px solid #aab0c8;
}

QFrame#body {
    border: 2px solid #f0f0f5;
    border-radius: 12px;
}