QWidget {
    background-color: #1e1f2b;
    color: #e8e8f0;
    font-size: 14px;
}

QPushButton {
    background-color: #b5532b;
    color: #fff4e6;
    border: 1px solid #ff9a5c;
    border-radius: 8px;
    padding: 6px;
}

QPushButton:hover {
    background-color: #d2693a;
}

QPushButton:pressed {
    background-color: #8f3d1c;
}

QPushButton:checked {
    background-color: #7a1f1f;
    border: 1px solid #ff6b4a;
}

QDoubleSpinBox, QComboBox {
    background-color: #2b2d3f;
    border: 1px solid #44475f;
    border-radius: 6px;
    padding: 2px 6px;
}

QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #ffb347;
}

QSlider::groove:vertical {
    width: 8px;
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff0000, stop:1 #000000);
}

QSlider::handle:vertical {
    height: 18px;
    margin: 0 -6px;
    background: #ffe0b2;
    border: 2px solid #ff9a5c;
    border-radius: 9px;
}

QLabel#body {
    border: 2px solid #f0f0f5;
    border-radius: 12px;
}

QLabel#bridge {
    background-color: #8a8fa8;
    border: 1px solid #aab0c8;
}

QLabel#temp_value {
    background-color: #171822;
    color: #ffb347;
    font-weight: bold;
    border: 1px solid #44475f;
    border-radius: 6px;
    padding: 2px 6px;
}

QLabel#title {
    font-size: 20px;
    font-weight: bold;
    color: #ffb347;
}

QLabel#subtitle {
    color: #9aa0b8;
}

QLabel#clock {
    color: #ffb347;
    font-weight: bold;
}

QLabel#status {
    color: #ffd166;
    font-weight: bold;
}

QLabel a {
    color: #7cc4ff;
}